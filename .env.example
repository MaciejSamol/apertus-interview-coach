# =====================================================================
# Apertus Interview Coach - configuration
# Copy to .env:   cp .env.example .env   (Windows: copy .env.example .env)
#
# Pick ONE of the two cases in section 1:
#   A) an LLM endpoint already exists (vLLM / any OpenAI-compatible API)
#        -> docker compose up --build -d
#   B) run the model locally on your own NVIDIA GPU (< 32 GB VRAM)
#        -> docker compose --profile gpu up --build -d
# Everything below section 1 has working defaults.
# =====================================================================


# ---------------------------------------------------------------------
# 1. LLM endpoint (required)
# ---------------------------------------------------------------------

# --- Case A: existing endpoint ---------------------------------------
# URL used by the coach container. Must end with /v1.
# Do NOT use localhost here (inside a container it means the container itself):
#   same machine -> http://host.docker.internal:8000/v1 , other machine -> http://<ip-or-host>:8000/v1
# --- Case B: local GPU -> keep http://vllm:8000/v1 (the vllm service of docker-compose.yml)
LLM_BASE_URL_DOCKER=http://vllm:8000/v1

# API key of the endpoint. Open endpoint (vLLM without --api-key) -> keep EMPTY.
LLM_API_KEY=EMPTY

# Model name exactly as returned by GET <url>/v1/models (field "id").
# Case B serves the model under this name, so keep the default there.
LLM_MODEL=swiss-ai/Apertus-v1.5-8B

# Optional: endpoint for the test scripts run with `uv run` on the host (simulate.py, eval_assess.py, chat_cli.py).
# Defaults to LLM_BASE_URL_DOCKER, so it only needs to be set if the host reaches the model under another URL.
# LLM_BASE_URL=


# ---------------------------------------------------------------------
# 2. Local GPU only (case B, `--profile gpu`) - ignored in case A
# ---------------------------------------------------------------------
# Hugging Face token; the model is gated: accept its terms on huggingface.co first.
HF_TOKEN=
# Default: full bf16 model, ~16 GB weights, fits < 32 GB VRAM.
# 16 GB GPU (e.g. RTX 4080): VLLM_MODEL=onprem-ai/Apertus-v1.5-8B-FP8 and VLLM_EXTRA_ARGS=--enforce-eager
VLLM_MODEL=swiss-ai/Apertus-v1.5-8B
VLLM_MAX_LEN=16384
VLLM_GPU_UTIL=0.85
# --enforce-eager: no CUDA graphs / torch.compile -> much less host RAM at startup
VLLM_EXTRA_ARGS=
# ARM64 host (e.g. NVIDIA DGX Spark): ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-arm64
VLLM_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-amd64


# ---------------------------------------------------------------------
# 3. Coach behaviour (optional)
# ---------------------------------------------------------------------
# Language when it cannot be detected from the first message: de | fr | it
COACH_DEFAULT_LANG=de
# informal (du/tu) | formal (Sie/vous/Lei)
COACH_ADDRESS=informal
# written (feedback table) | spoken (short TTS-friendly feedback)
COACH_FEEDBACK_MODE=written
# Follow-up questions per main question
COACH_MAX_FOLLOWUPS=1
LLM_TEMPERATURE=0.3
# true = fake LLM, tests the conversation flow without any model
COACH_MOCK_LLM=false


# ---------------------------------------------------------------------
# 4. Web UI (optional)
# ---------------------------------------------------------------------
# API URL as seen from the BROWSER (baked into the UI at build time).
# Change only if the UI is opened from another computer: http://<server>:2026
UI_API_URL=http://localhost:2026
UI_PORT=3000


# ---------------------------------------------------------------------
# 5. Infrastructure (optional, defaults are fine)
# ---------------------------------------------------------------------
# API port and Postgres credentials. docker compose sets the in-container hosts itself;
# the values below are also used by `uv run aegra dev` (development without Docker).
PORT=2026
POSTGRES_USER=hackapertustemplate26
POSTGRES_PASSWORD=hackapertustemplate26_secret
POSTGRES_DB=hackapertustemplate26
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
AUTH_TYPE=noop

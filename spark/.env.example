HF_TOKEN=
# Swiss AI publishes separate tags: latest-arm64 (DGX Spark) and latest-amd64
VLLM_IMAGE=ghcr.io/swiss-ai/vllm_apertus_1.5_release:latest-arm64
VLLM_MAX_LEN=32768
# Spark memory is shared CPU/GPU: 0.5 leaves ~60 GB for the OS, a judge model, LoRA, ...
VLLM_GPU_UTIL=0.5
VLLM_MAX_SEQS=32
VLLM_EXTRA_ARGS=
